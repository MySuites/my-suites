{
  "expo": {
    "name": "MyHealth",
    "slug": "myhealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Lotus_Icon.png",
    "scheme": "myhealth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mysuite.myhealth",
      "icon": "./assets/images/Lotus_Icon.png",
      "appleTeamId": "7Y22TWVLZ2",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "MyHealth uses your camera to let you attach photos to workouts and exercises.",
        "NSMicrophoneUsageDescription": "MyHealth uses your microphone for video recording.",
        "NSPhotoLibraryUsageDescription": "MyHealth uses your photo library to let you select and save progress pictures.",
        "NSPhotoLibraryAddUsageDescription": "MyHealth uses your photo library to let you save progress pictures."
      }
    },
    "android": {
      "package": "com.mysuite.myhealth",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Lotus_Icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Read your body weight data to sync with MyHealth.",
          "NSHealthUpdateUsageDescription": "Save your body weight data to Apple Health."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildSettings": {
              "ENABLE_USER_SCRIPT_SANDBOXING": "NO"
            }
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MyHealth uses your camera to let you attach photos to workouts and exercises.",
          "microphonePermission": "MyHealth uses your microphone for video recording.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MyHealth uses your photo library to let you select and save progress pictures.",
          "cameraPermission": "MyHealth uses your camera to let you attach photos to workouts and exercises."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd786c6a-c677-4bd7-9a6f-6191917893fb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd786c6a-c677-4bd7-9a6f-6191917893fb"
    }
  }
}
